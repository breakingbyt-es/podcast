---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import logo from '../assets/logo.jpeg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const episodes = (await getCollection('episodes')).sort(
  (a, b) => Number(b.data.episode) - Number(a.data.episode)
);
---

<Layout title="Habelas Hailas - Podcast de tecnología en Galicia">
  <div class="min-h-screen bg-[#030304] text-[#e5e5e5]">
    <!-- Header / Nav -->
    <header class="flex items-center justify-between px-7 py-5 font-['JetBrains_Mono',monospace] text-[11px] tracking-[0.18em] text-[#6b6b70]">
      <span class="inline-flex items-center gap-2 text-[#dc2626]">
        <span class="w-[6px] h-[6px] rounded-full bg-[#dc2626] shadow-[0_0_8px_#dc2626] animate-[pulse_2.4s_ease-in-out_infinite]"></span>
        <span class="status-text">SYSTEM ACTIVE</span>
      </span>
      <span class="site-id">HABELAS&nbsp;HAILAS</span>
      <nav class="hidden sm:flex items-center gap-8">
        <a href={`${base}#episodios`} class="hover:text-[#e5e5e5] transition-colors uppercase">episodios</a>
        <a href={`${base}#sobre`} class="hover:text-[#e5e5e5] transition-colors uppercase">sobre</a>
        <a href={`${base}#suscribir`} class="hover:text-[#e5e5e5] transition-colors uppercase">suscribir</a>
      </nav>
    </header>

    <!-- Hero Section -->
    <section class="py-24 md:py-36 px-6 max-w-5xl mx-auto">
      <div class="inline-flex items-center gap-2 text-xs font-['JetBrains_Mono',monospace] text-[#f8e473] border border-[#1c1c1f] px-3 py-1 mb-6 tracking-[0.18em]">
        <span class="w-1.5 h-1.5 rounded-full bg-[#f8e473]"></span>
        podcast // galicia.tech
      </div>
      <h1 class="text-5xl sm:text-7xl font-semibold tracking-tight text-[#e5e5e5] mb-6 uppercase leading-[0.95]">
        Tecnología gallega <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#dc2626] to-[#f8e473]">
          sin filtros.
        </span>
      </h1>
      <p class="text-lg text-[#6b6b70] mb-10 max-w-xl leading-relaxed font-['JetBrains_Mono',monospace] text-sm">
        // conversaciones con ingenieros, fundadores y constructores de software desde Galicia hacia el mundo.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="#episodios" class="bg-[#7f1d1d] hover:bg-[#dc2626] text-[#f5f5f5] border border-[#7f1d1d] font-['JetBrains_Mono',monospace] px-6 py-3.5 text-xs tracking-[0.14em] transition-all text-center uppercase">
          Ver episodios
        </a>
        <a href="#suscribir" class="bg-transparent hover:bg-[#0a0a0b]/70 text-[#e5e5e5] border border-[#1c1c1f] font-['JetBrains_Mono',monospace] px-6 py-3.5 text-xs tracking-[0.14em] transition-all text-center uppercase">
          Plataformas
        </a>
      </div>
    </section>

    <!-- Episodes Section -->
    <section id="episodios" class="py-24 px-6 border-t border-[#1c1c1f]">
      <div class="max-w-5xl mx-auto">
        <div class="mb-12 flex items-end justify-between">
          <div>
            <span class="text-xs font-['JetBrains_Mono',monospace] text-[#f8e473] uppercase tracking-[0.22em]">// ARCHIVO</span>
            <h2 class="text-3xl font-semibold text-[#e5e5e5] mt-1">Episodios</h2>
          </div>
          <span class="text-xs font-['JetBrains_Mono',monospace] text-[#6b6b70]">Temporada 01</span>
        </div>

        <div class="space-y-4">
          {episodes.map((entry) => (
            <article class="border border-[#1c1c1f] hover:border-[#7f1d1d] p-6 transition-all bg-[rgba(10,10,11,0.7)]">
              <div class="flex flex-col sm:flex-row gap-6 items-start">
                <Image src={logo} alt={`Episodio ${entry.data.episode}`} width={160} height={160} format="webp" quality={80} class="w-20 h-20 object-cover shrink-0 border border-[#1c1c1f]" />
                <div class="flex-1">
                  <div class="flex items-center gap-3 text-xs font-['JetBrains_Mono',monospace] text-[#6b6b70] mb-2 tracking-[0.14em]">
                    <span class="text-[#dc2626]">EP.{entry.data.episode}</span>
                    <span>•</span>
                    <span>{entry.data.duration}</span>
                    <span>•</span>
                    <span>{entry.data.date}</span>
                  </div>
                  <h3 class="text-xl font-semibold text-[#e5e5e5] mb-2">
                    <a href={`${base}/episodes/${entry.id}`} class="hover:text-[#dc2626] transition-colors">{entry.data.title}</a>
                  </h3>
                  <p class="text-[#6b6b70] text-sm mb-4 leading-relaxed font-['JetBrains_Mono',monospace] text-xs">
                    {entry.data.description}
                  </p>
                  <div class="flex items-center justify-between border-t border-[#1c1c1f] pt-4">
                    <span class="text-xs font-['JetBrains_Mono',monospace] text-[#6b6b70] tracking-[0.14em]">INVITADO: {entry.data.guest}</span>
                    <a href={`${base}/episodes/${entry.id}`} class="text-xs font-['JetBrains_Mono',monospace] font-medium text-[#dc2626] hover:text-[#ef4444] uppercase tracking-[0.14em] flex items-center gap-1.5 border-b border-[#7f1d1d] pb-[2px]">
                      [ Ver episodio ]
                    </a>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section id="sobre" class="py-24 px-6 border-t border-[#1c1c1f]">
      <div class="max-w-5xl mx-auto grid sm:grid-cols-2 gap-12">
        <div>
          <span class="text-xs font-['JetBrains_Mono',monospace] text-[#f8e473] uppercase tracking-[0.22em]">// MANIFIESTO</span>
          <h2 class="text-2xl font-semibold text-[#e5e5e5] mt-1 mb-4">Sobre el proyecto</h2>
          <p class="text-[#6b6b70] text-sm leading-relaxed mb-4 font-['JetBrains_Mono',monospace] text-xs">
            Habelas Hailas nace para dar voz al ecosistema tech gallego. Conversaciones directas, técnicas y sin adornos sobre código, arquitectura y producto.
          </p>
        </div>
        <div class="border border-[#1c1c1f] p-6 bg-[rgba(10,10,11,0.7)]">
          <h3 class="text-sm font-['JetBrains_Mono',monospace] text-[#dc2626] uppercase tracking-[0.18em] mb-3">// ESPECIFICACIONES</h3>
          <ul class="space-y-2 text-xs font-['JetBrains_Mono',monospace] text-[#6b6b70]">
            <li>> Frecuencia: Quincenal</li>
            <li>> Idioma: Castellano / Gallego</li>
            <li>> Formato: Entrevista técnica</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Subscribe / CTA Section -->
    <section id="suscribir" class="py-24 px-6 border-t border-[#1c1c1f] text-center">
      <div class="max-w-xl mx-auto">
        <span class="text-xs font-['JetBrains_Mono',monospace] text-[#f8e473] uppercase tracking-[0.22em]">// ACCESO</span>
        <h2 class="text-3xl font-semibold text-[#e5e5e5] mt-1 mb-3">Suscríbete</h2>
        <p class="text-[#6b6b70] text-sm mb-8 font-['JetBrains_Mono',monospace] text-xs">
          Disponible en todas las plataformas principales.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="#" class="border border-[#1c1c1f] hover:border-[#dc2626] text-[#e5e5e5] px-5 py-2.5 text-xs font-['JetBrains_Mono',monospace] uppercase tracking-[0.14em] transition-all bg-[rgba(10,10,11,0.7)]">
            Spotify
          </a>
          <a href="#" class="border border-[#1c1c1f] hover:border-[#dc2626] text-[#e5e5e5] px-5 py-2.5 text-xs font-['JetBrains_Mono',monospace] uppercase tracking-[0.14em] transition-all bg-[rgba(10,10,11,0.7)]">
            Apple Podcasts
          </a>
          <a href="#" class="border border-[#1c1c1f] hover:border-[#dc2626] text-[#e5e5e5] px-5 py-2.5 text-xs font-['JetBrains_Mono',monospace] uppercase tracking-[0.14em] transition-all bg-[rgba(10,10,11,0.7)]">
            RSS Feed
          </a>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-[#1c1c1f] py-12 px-6 text-xs font-['JetBrains_Mono',monospace] text-[#6b6b70] tracking-[0.18em]">
      <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
        <span>HABELAS_HAILAS // 2026</span>
        <span>GALICIA, SPAIN</span>
      </div>
    </footer>
  </div>
</Layout>
