---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import logo from '../../assets/logo.jpeg';

export async function getStaticPaths() {
  const episodes = await getCollection('episodes');
  return episodes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={`${entry.data.title} - Habelas Hailas`} description={entry.data.description}>
  <div class="min-h-screen bg-[#030304] text-[#e5e5e5]">
    <header class="flex items-center justify-between px-7 py-5 font-['JetBrains_Mono',monospace] text-[11px] tracking-[0.18em] text-[#6b6b70] border-b border-[#1c1c1f]">
      <a href={base + "/"} class="flex items-center gap-3 hover:text-[#e5e5e5] transition-colors">
        <Image src={logo} alt="Habelas Hailas Logo" width={72} height={72} format="webp" quality={80} class="w-9 h-9 object-cover border border-[#1c1c1f]" />
        <span class="font-semibold tracking-[0.18em] text-[#e5e5e5]">HABELAS&nbsp;HAILAS</span>
      </a>
      <a href={base + "/#episodios"} class="hover:text-[#e5e5e5] uppercase transition-colors">← volver</a>
    </header>

    <main class="max-w-3xl mx-auto px-6 py-16">
      <div class="flex items-center gap-3 text-xs font-['JetBrains_Mono',monospace] text-[#6b6b70] mb-4 tracking-[0.14em]">
        <span class="text-[#dc2626]">EP.{entry.data.episode}</span>
        <span>•</span>
        <span>{entry.data.duration}</span>
        <span>•</span>
        <span>{entry.data.date}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-semibold text-[#e5e5e5] mb-4 leading-tight">{entry.data.title}</h1>
      <p class="text-[#6b6b70] text-sm font-['JetBrains_Mono',monospace] mb-8 tracking-[0.14em]">INVITADO: {entry.data.guest}</p>

      <div class="prose prose-invert max-w-none font-['JetBrains_Mono',monospace] text-sm text-[#e5e5e5] prose-headings:font-semibold prose-headings:text-[#e5e5e5] prose-a:text-[#dc2626] hover:prose-a:text-[#ef4444] prose-strong:text-[#e5e5e5]">
        <Content />
      </div>

      <div class="border-t border-[#1c1c1f] mt-12 pt-8">
        <a href={base + "/#episodios"} class="text-xs font-['JetBrains_Mono',monospace] font-medium text-[#dc2626] hover:text-[#ef4444] uppercase tracking-[0.14em] border-b border-[#7f1d1d] pb-[2px]">
          [ ← volver a episodios ]
        </a>
      </div>
    </main>

    <footer class="border-t border-[#1c1c1f] py-12 px-6 text-xs font-['JetBrains_Mono',monospace] text-[#6b6b70] tracking-[0.18em]">
      <div class="max-w-3xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
        <span>HABELAS_HAILAS // 2026</span>
        <span>GALICIA, SPAIN</span>
      </div>
    </footer>
  </div>
</Layout>
