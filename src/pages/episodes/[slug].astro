---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import logo from '../../assets/logo.jpeg';

export async function getStaticPaths() {
  const episodes = await getCollection('episodes');
  return episodes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={`${entry.data.title} - Habelas Hailas`} description={entry.data.description}>
  <div class="min-h-screen bg-[#0c0c0e] text-[#ededed] selection:bg-emerald-400 selection:text-black">
    <header class="border-b border-[#222226] bg-[#0c0c0e]/80 backdrop-blur sticky top-0 z-50">
      <div class="max-w-3xl mx-auto px-6 h-20 flex items-center justify-between">
        <a href={base + "/"} class="flex items-center gap-3">
          <Image src={logo} alt="Habelas Hailas Logo" width={72} height={72} format="webp" quality={80} class="w-9 h-9 rounded object-cover border border-[#333]" />
          <span class="font-bold tracking-tight text-lg text-white">HABELAS<span class="text-emerald-400">HAILAS</span></span>
        </a>
        <a href={base + "/#episodios"} class="text-xs font-mono text-zinc-400 hover:text-white uppercase transition-colors">← volver</a>
      </div>
    </header>

    <main class="max-w-3xl mx-auto px-6 py-16">
      <div class="flex items-center gap-3 text-xs font-mono text-zinc-500 mb-4">
        <span class="text-emerald-400">EP.{entry.data.episode}</span>
        <span>•</span>
        <span>{entry.data.duration}</span>
        <span>•</span>
        <span>{entry.data.date}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-4 leading-tight">{entry.data.title}</h1>
      <p class="text-zinc-400 text-sm font-mono mb-8">INVITADO: {entry.data.guest}</p>

      <div class="prose prose-invert prose-emerald max-w-none font-mono text-sm text-zinc-300">
        <Content />
      </div>

      <div class="border-t border-[#222226] mt-12 pt-8">
        <a href={base + "/#episodios"} class="text-xs font-mono font-bold text-emerald-400 hover:text-emerald-300 uppercase tracking-wider">
          [ ← volver a episodios ]
        </a>
      </div>
    </main>

    <footer class="border-t border-[#222226] py-12 px-6 text-xs font-mono text-zinc-500">
      <div class="max-w-3xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
        <span>HABELAS_HAILAS // 2026</span>
        <span>GALICIA, SPAIN</span>
      </div>
    </footer>
  </div>
</Layout>
